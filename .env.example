SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# WhatsApp pela Evolution API (docker compose do repo: npm run whatsapp:up).
# Sem estas variáveis, ou sem número pareado, as confirmações ficam no simulador do app (/paciente/whatsapp).
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-por-uma-chave-longa
EVOLUTION_INSTANCE=remark
EVOLUTION_WEBHOOK_TOKEN=troque-por-um-token-longo
