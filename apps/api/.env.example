# Local por padrão; use 0.0.0.0 apenas quando necessário para containers/deploy.
HOST=127.0.0.1
PORT=3001
# Postgres local de compose.yaml (`docker compose up -d --wait postgres`).
DATABASE_URL=postgresql://hackathon:hackathon@127.0.0.1:5432/hackathon
# Segredo de assinatura das sessões: no mínimo 32 caracteres. Gere com `openssl rand -base64 32`.
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres
# URL pública da API, usada pela biblioteca de autenticação.
BETTER_AUTH_URL=http://127.0.0.1:3001
# Testes: banco separado, migrado por `npm run test -w @hackathon/api`.
# TEST_DATABASE_URL=postgresql://hackathon:hackathon@127.0.0.1:5432/hackathon_test
