# Local por padrão; use 0.0.0.0 apenas quando necessário para containers/deploy.
HOST=127.0.0.1
PORT=3001
# Postgres do docker compose da raiz (usuário e senha locais, sem segredo real).
DATABASE_URL=postgresql://hackathon:hackathon@127.0.0.1:5432/hackathon
# Mínimo de 32 caracteres. Gere um local com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública da própria API e origem do Next que chama a API.
BETTER_AUTH_URL=http://127.0.0.1:3001
WEB_ORIGIN=http://127.0.0.1:3000
# Controle de tempo da demo (HACK-30). Ligado, exige DEMO_CLOCK_TOKEN com 32 caracteres
# ou mais (gere com: openssl rand -base64 32), enviado no header x-demo-clock-token.
DEMO_CLOCK_ENABLED=false
DEMO_CLOCK_TOKEN=
# Geocodificação do endereço da clínica (HACK-16). Nominatim público serve só à demo;
# uso real troca a URL. O User-Agent identifica o app (sem e-mail pessoal) e o
# intervalo mínimo entre chamadas segue a política de 1 requisição por segundo.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=hackathon-usp-marketplace/0.1
GEOCODER_MIN_INTERVAL_MS=1000
