// Autenticação (Better Auth, HACK-12) e modelo de domínio (HACK-13).
// Unidades do domínio: dinheiro em centavos (Int, sufixo Cents), percentuais Int 0-100,
// durações Int em minutos, instantes em UTC (timestamp(3)) e expediente/janelas em hora
// local de America/Sao_Paulo (weekday 0-6 a partir de domingo, minuto do dia 0-1440).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  // Índice único parcial (`where: raw(...)`) da trava da vaga, RN-41 (porta 4 da fatia 2).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // Papel da conta: "paciente" ou "clinica". Fixado pela rota de cadastro; sem default,
  // então um insert sem papel falha (D1, D2).
  role          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  clinic        Clinic?
  patient       Patient?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Domínio · HACK-13 fatia 1
// ---------------------------------------------------------------------------

// Perfil de clínica de um User (role "clinica"), um para um (RN-01).
model Clinic {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  address            String
  latitude           Float
  longitude          Float
  cnes               String               @unique
  technicalManager   String
  // Alvo para conexão manual na demo; não indica OAuth conectado.
  demoCalendarTarget Boolean              @default(false)
  // Teto diário de vagas com desconto (RN-28).
  dailyDiscountCap   Int                  @default(5)
  // Percentual do sinal sobre o preço do momento (RN-40, D1).
  depositPercent     Int                  @default(20)
  // Tamanho da onda de alertas e Z, a espera por onda (RN-34, D3).
  waveSize           Int                  @default(5)
  waveWindowMinutes  Int                  @default(10)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  openingHours       ClinicOpeningHours[]
  exams              Exam[]
  slots              Slot[]
  // Google Agenda conectada por OAuth (HACK-18); ausência = nunca conectou.
  calendarConnection CalendarConnection?
}

// Faixa de expediente num dia da semana, em hora local.
model ClinicOpeningHours {
  id          String @id @default(uuid()) @db.Uuid
  clinicId    String @db.Uuid
  clinic      Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  weekday     Int
  startMinute Int
  endMinute   Int

  @@index([clinicId])
}

// Exame oferecido pela clínica (RN-02). O banco garante piso <= preço cheio e
// X, Y > 0 por CHECK escrito na migration (o Prisma não descreve CHECK no schema).
model Exam {
  id                   String      @id @default(uuid()) @db.Uuid
  clinicId             String      @db.Uuid
  clinic               Clinic      @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  tussCode             String
  name                 String
  fullPriceCents       Int
  floorPriceCents      Int
  // Antecedência mínima para encaixe.
  minLeadMinutes       Int
  preparationCondition String
  preparationHours     Int
  // Ids de pergunta do catálogo do HACK-41 que contraindicam o exame.
  contraindications    String[]
  // X: tolerância de atraso; Y: tempo máximo para chegar no no-show (RN-33).
  toleranceMinutes     Int
  maxTravelMinutes     Int
  // Chave e versão do questionário no catálogo do HACK-41 (D5).
  questionnaireKey     String
  questionnaireVersion Int
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  priceSteps           PriceStep[]
  slots                Slot[]

  @@unique([clinicId, tussCode])
  // Alvo da FK composta Slot(examId, clinicId): o horário só aponta exame da própria clínica.
  @@unique([id, clinicId])
}

// Degrau de preço: desconto aplicado quando faltam leadMinutes para o horário (RN-26).
model PriceStep {
  id              String @id @default(uuid()) @db.Uuid
  examId          String @db.Uuid
  exam            Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  leadMinutes     Int
  discountPercent Int

  // Um degrau por antecedência: dois descontos no mesmo ponto deixariam o preço ambíguo.
  @@unique([examId, leadMinutes])
}

// Perfil de paciente de um User (role "paciente"), um para um (RN-11).
model Patient {
  id                  String                     @id @default(uuid()) @db.Uuid
  userId              String                     @unique
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone               String
  // Telefone confirmado por código; sem isso o WhatsApp não é usado (HACK-34).
  phoneVerifiedAt     DateTime?
  // Canais em que o paciente aceita receber alertas (RN-35, HACK-34).
  alertChannels       AlertChannel[]             @default([push, email])
  // Aceite do termo LGPD de dado de saúde; sem ele a conta não nasce (F1).
  healthDataConsentAt DateTime
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  subscriptions       Subscription[]
  reservations        Reservation[]
  whatsappMessages    SimulatedWhatsappMessage[]
  phoneVerification   PhoneVerification?
  pushSubscriptions   PushSubscription[]
}

// Inscrição na lista de encaixe (RN-17). Uma por paciente e TUSS: renovar ou se
// reinscrever atualiza a mesma linha (RN-20, D4).
model Subscription {
  id               String               @id @default(uuid()) @db.Uuid
  patientId        String               @db.Uuid
  patient          Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  tussCode         String
  maxPriceCents    Int
  // Centro e raio da região.
  latitude         Float
  longitude        Float
  radiusMeters     Int
  // "Posso ir hoje", com a localização atual informada.
  canGoToday       Boolean              @default(false)
  currentLatitude  Float?
  currentLongitude Float?
  expiresAt        DateTime
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  windows          SubscriptionWindow[]
  alerts           Alert[]

  @@unique([patientId, tussCode])
}

// Janela de disponibilidade do paciente num dia da semana, em hora local (RN-21).
model SubscriptionWindow {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  weekday        Int
  startMinute    Int
  endMinute      Int

  @@index([subscriptionId])
}

// ---------------------------------------------------------------------------
// Domínio · HACK-13 fatia 2
// ---------------------------------------------------------------------------
// Nomes em inglês; valores dos enums em português, iguais aos da spec (RN-24).
// Todas as FKs desta fatia são Restrict: horário, vaga, reserva, alerta e transição
// são histórico (RN-50, RN-51) e não somem em cascata.
// Faixas numéricas e invariantes de forma ficam em CHECK escrito na migration.

enum SlotOrigin {
  agenda
  manual
}

enum VacancyOrigin {
  cancelamento
  no_show
  vazio
}

// Estados da vaga (RN-24). A ordem das transições é regra do HACK-29.
enum VacancyState {
  publicada
  alertando
  reservada
  realizada
  expirada
  cancelada
}

enum ReservationType {
  comum
  encaixe
  no_show
}

// Reserva ativa = confirmada ou realizada: só ela ocupa a vaga e o horário (RN-41).
enum ReservationState {
  aguardando_pagamento
  confirmada
  realizada
  no_show
  cancelada
  expirada
}

enum PaymentMethod {
  pix
  cartao
  no_local
}

enum AlertChannel {
  push
  email
  whatsapp
}

enum AlertResult {
  pendente
  enviado
  falhou
  cancelado
  // Canal ativo do paciente sem como enviar: sem adapter (fornecedor não
  // configurado) ou WhatsApp sem telefone verificado. Tira o paciente da fila
  // daquela vaga, como um alerta enviado (HACK-48).
  sem_canal
}

enum TransitionOrigin {
  agenda
  clinica
  paciente
  motor
}

// Horário da agenda de um exame. O banco garante fim > início (CHECK) e, pela FK
// composta (examId, clinicId) → Exam(id, clinicId), que o exame é da mesma clínica.
model Slot {
  id            String        @id @default(uuid()) @db.Uuid
  clinicId      String        @db.Uuid
  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  examId        String        @db.Uuid
  exam          Exam          @relation(fields: [examId, clinicId], references: [id, clinicId], onDelete: Restrict)
  startsAt      DateTime
  endsAt        DateTime
  origin        SlotOrigin
  // Id do evento na Google Agenda (HACK-19).
  googleEventId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  vacancies     Vacancy[]
  reservations  Reservation[]

  @@index([clinicId, startsAt])
  @@index([examId])
}

// Vaga de encaixe num horário (RN-22). No máximo uma ativa por horário.
// O predicado dos índices parciais está na forma que o Postgres guarda (pg_get_expr):
// escrito como `IN (...)`, o `migrate diff` veria drift e recriaria o índice.
model Vacancy {
  id                String        @id @default(uuid()) @db.Uuid
  slotId            String        @db.Uuid
  slot              Slot          @relation(fields: [slotId], references: [id], onDelete: Restrict)
  origin            VacancyOrigin
  state             VacancyState  @default(publicada)
  // Preço do momento, recalculado pelos degraus (RN-26).
  currentPriceCents Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  reservations      Reservation[]
  alerts            Alert[]
  transitions       Transition[]

  // Alvo da FK composta Reservation(vacancyId, slotId): a reserva da vaga fica no horário dela.
  @@unique([id, slotId])
  @@unique([slotId], map: "Vacancy_active_slot_key", where: raw("state = ANY (ARRAY['publicada'::\"VacancyState\", 'alertando'::\"VacancyState\", 'reservada'::\"VacancyState\"])"))
}

// Reserva de um horário. Comum: só slotId; encaixe e no-show: slotId e vacancyId (CHECK).
// A trava da RN-41 são os dois índices parciais: a confirmação que chega depois
// recebe P2002 e o HACK-27 responde "vaga acabou de ser preenchida". A FK composta
// (vacancyId, slotId) → Vacancy(id, slotId) amarra o slotId do encaixe ao horário da
// vaga (MATCH SIMPLE: a comum, com vacancyId nulo, não é checada); sem ela, um encaixe
// gravado noutro horário furava o índice de horário.
model Reservation {
  id                String           @id @default(uuid()) @db.Uuid
  slotId            String           @db.Uuid
  slot              Slot             @relation(fields: [slotId], references: [id], onDelete: Restrict)
  vacancyId         String?          @db.Uuid
  vacancy           Vacancy?         @relation(fields: [vacancyId, slotId], references: [id, slotId], onDelete: Restrict)
  patientId         String           @db.Uuid
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  type              ReservationType
  state             ReservationState @default(aguardando_pagamento)
  chargedPriceCents Int
  // Sinal pago (RN-40); 0 na reserva comum paga no local.
  depositCents      Int
  // no_local só na reserva comum (RN-39, CHECK).
  paymentMethod     PaymentMethod
  googleEventId     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  transitions       Transition[]

  @@unique([vacancyId], map: "Reservation_active_vacancy_key", where: raw("state = ANY (ARRAY['confirmada'::\"ReservationState\", 'realizada'::\"ReservationState\"])"))
  @@unique([slotId], map: "Reservation_active_slot_key", where: raw("state = ANY (ARRAY['confirmada'::\"ReservationState\", 'realizada'::\"ReservationState\"])"))
  @@index([vacancyId])
  @@index([slotId])
  @@index([patientId])
}

// Alerta de uma vaga a uma inscrição, uma linha por canal (RN-34, RN-36).
model Alert {
  id             String       @id @default(uuid()) @db.Uuid
  vacancyId      String       @db.Uuid
  vacancy        Vacancy      @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  // Número da onda, a partir de 1.
  wave           Int
  channel        AlertChannel
  sentAt         DateTime?
  result         AlertResult  @default(pendente)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([vacancyId, subscriptionId, channel])
  @@index([subscriptionId])
}

// Registro de mudança de estado de uma vaga ou de uma reserva, exatamente um alvo
// (CHECK). fromState/toState são texto porque guardam valores de dois enums; quem
// valida e grava é o HACK-29, na mesma transação da mudança (RN-50).
model Transition {
  id            String           @id @default(uuid()) @db.Uuid
  vacancyId     String?          @db.Uuid
  vacancy       Vacancy?         @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  reservationId String?          @db.Uuid
  reservation   Reservation?     @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  // Nulo na criação.
  fromState     String?
  toState       String
  origin        TransitionOrigin
  reason        String
  occurredAt    DateTime         @default(now())

  @@index([vacancyId, occurredAt])
  @@index([reservationId, occurredAt])
}

// Relógio da demo (HACK-30): deslocamento aplicado ao relógio real por todas as
// regras de tempo. Uma linha só (id = 1, CHECK), para sobreviver a um restart.
model DemoClock {
  id            Int      @id @default(1)
  offsetMinutes Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// WhatsApp simulado (HACK-37)
// ---------------------------------------------------------------------------

enum SimulatedWhatsappKind {
  alerta
  codigo_verificacao
}

// Mensagem que seria enviada pelo WhatsApp no piloto, mostrada em /demo/whatsapp.
// Fica no banco, não na memória, para a tela ver o que outra instância gravou.
model SimulatedWhatsappMessage {
  id        String                @id @default(uuid()) @db.Uuid
  patientId String                @db.Uuid
  patient   Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  phone     String
  kind      SimulatedWhatsappKind
  body      String
  // Alerta de origem: no máximo uma mensagem por Alert, mesmo no reenvio (HACK-45).
  alertId   String?               @unique @db.Uuid
  createdAt DateTime              @default(now())

  @@index([createdAt])
}

// Código de verificação do telefone em andamento, um por paciente (HACK-37).
// Só o HMAC do código é guardado; expira e tem limite de tentativas.
model PhoneVerification {
  patientId String   @id @db.Uuid
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  sentAt    DateTime @default(now())
}

// Status da conexão com a Google Agenda (HACK-18). EXPIRED cobre expirado e revogado:
// o Google devolve o mesmo invalid_grant nos dois casos.
enum CalendarConnectionStatus {
  DISCONNECTED
  AWAITING_CALENDAR
  CONNECTED
  EXPIRED
}

// Autorização Google de uma clínica e a agenda escolhida (HACK-18, porta 1). Tokens só
// cifrados no formato v1.<iv>.<tag>.<cifra> (AES-256-GCM, AAD = clinicId, porta 2).
// O state OAuth pendente mora na mesma linha: só o SHA-256 dele, a sessão que o gerou
// e a validade (relógio real); é zerado ao ser consumido.
model CalendarConnection {
  id                   String                   @id @default(uuid()) @db.Uuid
  clinicId             String                   @unique @db.Uuid
  clinic               Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  status               CalendarConnectionStatus @default(DISCONNECTED)
  refreshToken         String?
  accessToken          String?
  accessTokenExpiresAt DateTime?
  calendarId           String?
  calendarName         String?
  connectedAt          DateTime?
  oauthStateHash       String?
  oauthStateSessionId  String?
  oauthStateExpiresAt  DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
}

// Destinos de web push por navegador; removidos quando o fornecedor retorna 404/410.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}
