# Server-only URL. Never prefix secrets or internal addresses with NEXT_PUBLIC_.
API_BASE_URL=http://127.0.0.1:3001
# URL pública do Nest para o socket de tempo real (o navegador precisa dela; não é segredo).
NEXT_PUBLIC_REALTIME_URL=http://127.0.0.1:3001
# Segredo do operador da demo (o mesmo DEMO_CLOCK_TOKEN da API). Só no servidor do Next.
# As telas /demo/* pedem Basic Auth com ele como senha (qualquer usuário); vazio, elas
# respondem 404. Nunca prefixar com NEXT_PUBLIC_.
DEMO_CLOCK_TOKEN=
